# Copy this file to .env. Keep .env private; never commit real keys.
# Leave ALL three keys empty to use the app's scripted demo.
# Each key enables only that provider's models. Live API calls may be billed.
HF_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force scripted demo mode even when provider keys exist.
# Vercel deployments always run the public demo; real inference stays local.
PUBLIC_DEMO=false

# The local app defaults to http://localhost:3000.
PORT=3000
HOST=127.0.0.1

# Set the exact public origin only after preparing a hosted deployment.
# Example: APP_ORIGIN=https://your-app.example
APP_ORIGIN=

# Hugging Face Inference Providers model IDs. Availability may change.
HF_MODEL_1=Qwen/Qwen3-Coder-480B-A35B-Instruct
HF_MODEL_1_NAME=Qwen3 Coder
HF_MODEL_2=deepseek-ai/DeepSeek-R1
HF_MODEL_2_NAME=DeepSeek R1
HF_MODEL_3=zai-org/GLM-4.5
HF_MODEL_3_NAME=GLM 4.5
HF_MODEL_4=meta-llama/Llama-3.3-70B-Instruct
HF_MODEL_4_NAME=Llama 3.3 70B
HF_MODEL_5=openai/gpt-oss-20b
HF_MODEL_5_NAME=GPT-OSS 20B

# Direct provider models require their separate API keys above.
# GPT-OSS uses HF_TOKEN; GPT-5 mini uses OPENAI_API_KEY.
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_NAME=GPT-5 mini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_NAME=Gemini 3.8 Flash

# Optional rates in USD per million tokens from your actual provider.
# Set BOTH input and output rates for each model, or leave BOTH blank.
# Use finite numbers >= 0. Incomplete or invalid pairs prevent startup.
# Estimates require live provider input/output token counts; bills may differ.
HF_MODEL_1_INPUT_USD_PER_MILLION=
HF_MODEL_1_OUTPUT_USD_PER_MILLION=
HF_MODEL_2_INPUT_USD_PER_MILLION=
HF_MODEL_2_OUTPUT_USD_PER_MILLION=
HF_MODEL_3_INPUT_USD_PER_MILLION=
HF_MODEL_3_OUTPUT_USD_PER_MILLION=
HF_MODEL_4_INPUT_USD_PER_MILLION=
HF_MODEL_4_OUTPUT_USD_PER_MILLION=
HF_MODEL_5_INPUT_USD_PER_MILLION=
HF_MODEL_5_OUTPUT_USD_PER_MILLION=
OPENAI_MODEL_INPUT_USD_PER_MILLION=
OPENAI_MODEL_OUTPUT_USD_PER_MILLION=
GEMINI_MODEL_INPUT_USD_PER_MILLION=
GEMINI_MODEL_OUTPUT_USD_PER_MILLION=
